{
    "name": "5G-kubearmor-policies",
    "attributes": {
    },
    "ruleLanguage": "Rego",
    "match": [
      {
        "apiGroups": [
          "apps"
        ],
        "apiVersions": [
          "v1"
        ],
        "resources": [
            "Deployment"
        ]
      },
      {
        "apiGroups": [
          "security.kubearmor.com"
        ],
        "apiVersions": [
          "v1"
        ],
        "resources": [
            "KubeArmorPolicy"
        ]
      },
      {
        "apiGroups": [
          "security.seran.org"
        ],
        "apiVersions": [
          "v1alpha1"
        ],
        "resources": [
            "WorkloadConfig"
        ]       
      }
    ],
    "ruleDependencies": [
    ],
    "description": "fails if there are no kubearmor policies present for the defined 5G workloads",
    "remediation": "Make sure kubearmor policies are created for all workloads",
    "ruleQuery": "armo_builtins"
}